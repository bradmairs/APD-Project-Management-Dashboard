DATABASE_URL="postgresql://apd:apd@localhost:5432/apd_dashboard"
PORT=4000
# Generate a random secret, e.g.: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me

# Optional. Ollama server for the AI Assistant feature. Running the backend
# directly on the host (not via docker-compose) means Ollama is reachable
# at localhost; docker-compose.yml overrides this to host.docker.internal
# for the containerized deployment. OLLAMA_MODEL must match a tag Ollama
# actually has pulled EXACTLY — a bare "ollama pull llama3.1" can land as
# a versioned tag like "llama3.1:8b" rather than "llama3.1:latest", and
# Ollama's API 404s on any mismatch rather than falling back. Run
# `ollama list` on that server and copy the NAME column verbatim.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
