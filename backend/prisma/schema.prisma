generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  DESIGN
  TENDER
  CONSTRUCTION
  DEFECTS_LIABILITY
  COMPLETE
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                     String        @id @default(cuid())
  name                   String
  description            String?
  assetType              String?
  status                 ProjectStatus @default(PLANNING)
  projectManager         String?
  location               String?
  contractor             String?
  budget                 Decimal?      @db.Decimal(14, 2)
  contractValue          Decimal?      @db.Decimal(14, 2)
  startDate              DateTime?
  targetCompletionDate   DateTime?
  actualCompletionDate   DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tasks                  Task[]
}

model Task {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
}
