generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  DESIGN
  TENDER
  CONSTRUCTION
  DEFECTS_LIABILITY
  COMPLETE
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Role {
  ADMIN
  MEMBER
}

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum CashFlowType {
  ACTUAL
  FORECAST
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(MEMBER)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  activityLogs   ActivityLog[]
  attachments    Attachment[]
  createdProjects Project[]
  monthlyReports MonthlyReport[]
  siteVisits     SiteVisit[]
  siteVisitPhotos SiteVisitPhoto[]
}

model Project {
  id                     String        @id @default(cuid())
  name                   String
  description            String?
  assetType              String?
  status                 ProjectStatus @default(PLANNING)
  bpRefNo                String?
  projectManager         String?
  projectDirector        String?
  projectSponsor         String?
  location               String?
  contractor             String?
  budget                 Decimal?      @db.Decimal(14, 2)
  contingency            Decimal?      @db.Decimal(14, 2)
  contractValue          Decimal?      @db.Decimal(14, 2)
  startDate              DateTime?
  targetCompletionDate   DateTime?
  actualCompletionDate   DateTime?
  createdById            String?
  createdBy              User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tasks                  Task[]
  activityLogs           ActivityLog[]
  attachments            Attachment[]
  monthlyReports         MonthlyReport[]
  milestones             Milestone[]
  cashFlowEntries        CashFlowEntry[]
  siteVisits             SiteVisit[]
}

model Task {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
}

// Files (drawings, contracts, correspondence) attached to a project.
// Deleted with its project (unlike ActivityLog) since the underlying file on
// disk is deleted at the same time — there's nothing left for the row to
// document once that happens.
model Attachment {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  storedFilename String
  originalName   String
  mimeType       String
  size           Int
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([projectId])
}

// A major project deliverable from the WBS schedule table in the monthly
// report (Concept Design, Detailed Design, Construction, ...). Unlike
// MonthlyReport this is a live, current list — matching Task, it reflects
// where the project's schedule stands right now rather than a per-month
// snapshot, since re-entering the whole WBS table every month would be
// needless duplication for rows that mostly don't change month to month.
// sortOrder preserves the WBS sequence (each new row appends to the end;
// reordering swaps two rows' values) since that order is meaningful and
// isn't derivable from any other field.
model Milestone {
  id                   String    @id @default(cuid())
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  wbsItem              String?
  taskActivity         String
  percentComplete      Int       @default(0)
  originalCompletion   DateTime?
  forecastedCompletion DateTime?
  actualCompletion     DateTime?
  notes                String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([projectId])
}

// One month's actual or forecast spend, from the monthly cash flow
// breakdown tables in the report. Like Milestone (and unlike MonthlyReport)
// this is live, current data — a month's actual figure, once entered,
// generally doesn't need re-editing, and a forecast is expected to be
// revised as the project progresses, so there's no value in snapshotting
// it per report. Unique on (project, month, type) rather than treating
// actual/forecast as one row per month, since a month can carry both (a
// forecast entered ahead of time, later followed by that month's actual
// once it closes) without one overwriting the other.
model CashFlowEntry {
  id        String       @id @default(cuid())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  month     DateTime
  type      CashFlowType
  amount    Decimal      @db.Decimal(14, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, month, type])
  @@index([projectId])
}

// A monthly project report snapshot, matching the board-reporting template
// PMs already fill in manually. Each (project, reportingMonth) pair is its
// own row rather than a set of live fields — a past month's report is a
// historical record and shouldn't change as the project moves on, the same
// way the source document is a point-in-time report, not a live view.
// Cascades with its project (unlike ActivityLog) since a report only makes
// sense in that project's context — there's no standalone value in a report
// row once the project itself is gone.
model MonthlyReport {
  id                String    @id @default(cuid())
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  reportingMonth    DateTime
  projectPhase      String
  currentStatus     String
  recentlyCompleted String?
  monthlyLookahead  String?
  budgetHealth      RagStatus @default(GREEN)
  budgetComments    String?
  scheduleHealth    RagStatus @default(GREEN)
  scheduleComments  String?
  createdBy         User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById       String?
  authorName        String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, reportingMonth])
  @@index([projectId])
}

// A field record of a site visit — mobile-friendly since it's typically
// logged from a phone on site. Like Milestone/CashFlowEntry (and unlike
// MonthlyReport) this isn't a monthly snapshot; each visit is its own
// point-in-time record, dated by when it happened rather than a reporting
// month, so there's naturally many per month rather than one. Cascades with
// its project since a visit log only makes sense in that project's context.
model SiteVisit {
  id              String    @id @default(cuid())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  visitDate       DateTime
  location        String
  notes           String?
  discussionNotes String?
  visitedBy       User?     @relation(fields: [visitedById], references: [id], onDelete: SetNull)
  visitedById     String?
  visitedByName   String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  photos          SiteVisitPhoto[]

  @@index([projectId])
}

// A photo attached to a site visit. latitude/longitude/takenAt are read
// server-side from the file's own EXIF GPS/DateTimeOriginal tags at upload
// time (never trusted from the client) — a photo with no GPS tag (location
// services were off, or it came from a gallery rather than the camera)
// simply has null coordinates and is shown in the thumbnail grid but never
// plotted on the map. Cascades with its site visit for the same reason
// Attachment cascades with its project: the file on disk goes with it, so
// there's nothing left for the row to document once that happens.
model SiteVisitPhoto {
  id             String    @id @default(cuid())
  siteVisit      SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  siteVisitId    String
  storedFilename String
  originalName   String
  mimeType       String
  size           Int
  latitude       Float?
  longitude      Float?
  takenAt        DateTime?
  uploadedBy     User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime  @default(now())

  @@index([siteVisitId])
}

// Append-only audit trail. projectName/userName are snapshots taken at write
// time so an entry stays meaningful even after its project or user is gone
// (project relation is SET NULL on delete rather than cascaded, so a
// project's "deleted" entry — and its history — outlives the project row).
model ActivityLog {
  id          String   @id @default(cuid())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  projectName String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  userName    String
  action      String
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
