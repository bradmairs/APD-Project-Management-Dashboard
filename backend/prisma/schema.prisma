generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  DESIGN
  TENDER
  CONSTRUCTION
  DEFECTS_LIABILITY
  COMPLETE
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(MEMBER)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  activityLogs   ActivityLog[]
  attachments    Attachment[]
  createdProjects Project[]
}

model Project {
  id                     String        @id @default(cuid())
  name                   String
  description            String?
  assetType              String?
  status                 ProjectStatus @default(PLANNING)
  projectManager         String?
  location               String?
  contractor             String?
  budget                 Decimal?      @db.Decimal(14, 2)
  contractValue          Decimal?      @db.Decimal(14, 2)
  startDate              DateTime?
  targetCompletionDate   DateTime?
  actualCompletionDate   DateTime?
  createdById            String?
  createdBy              User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tasks                  Task[]
  activityLogs           ActivityLog[]
  attachments            Attachment[]
}

model Task {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
}

// Files (drawings, contracts, correspondence) attached to a project.
// Deleted with its project (unlike ActivityLog) since the underlying file on
// disk is deleted at the same time — there's nothing left for the row to
// document once that happens.
model Attachment {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  storedFilename String
  originalName   String
  mimeType       String
  size           Int
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([projectId])
}

// Append-only audit trail. projectName/userName are snapshots taken at write
// time so an entry stays meaningful even after its project or user is gone
// (project relation is SET NULL on delete rather than cascaded, so a
// project's "deleted" entry — and its history — outlives the project row).
model ActivityLog {
  id          String   @id @default(cuid())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  projectName String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  userName    String
  action      String
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
